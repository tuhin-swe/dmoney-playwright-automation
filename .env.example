# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# DMoney portal under test
BASE_URL=https://dmoneyportal.roadtocareer.net

# Built-in privileged accounts (provided by the assignment)
ADMIN_EMAIL=admin@dmoney.com
ADMIN_PASSWORD=1234
SYSTEM_EMAIL=system@dmoney.com
SYSTEM_PASSWORD=1234

# Gmail inbox used to (a) receive agent login OTPs and (b) receive the password-reset link.
# Registration emails are generated as GMAIL_USER with a +alias, so every run is unique
# while all mail lands in this one inbox.
# GMAIL_APP_PASSWORD is a 16-char Google "App password" (Account > Security > App passwords),
# NOT your normal Gmail password. Requires 2-Step Verification to be enabled.
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
